# 在等号后填写百炼 API Key；不要把说明文字或 // 注释写进密钥值。
ZHENLU_DRAFT_PROVIDER=qwen
ZHENLU_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZHENLU_QWEN_MODEL=qwen3.7-plus
ZHENLU_QWEN_API_KEY=
ZHENLU_QWEN_TIMEOUT_SECONDS=45
ZHENLU_QWEN_ATTEMPT_TIMEOUT_SECONDS=20
ZHENLU_QWEN_MAX_RETRIES=1
ZHENLU_QWEN_MAX_TOKENS=2000

# 会话问答与实时临床助手共用此模型，复用上面的千问地址和密钥。
ZHENLU_ASSISTANT_PROVIDER=qwen
ZHENLU_ASSISTANT_MODEL=qwen3.7-plus
ZHENLU_LIVE_ASSISTANT_ENABLED=true
ZHENLU_LIVE_ASSISTANT_DEBOUNCE_SECONDS=2
ZHENLU_LIVE_ASSISTANT_MIN_INTERVAL_SECONDS=10
ZHENLU_LIVE_ASSISTANT_MAX_RUNS_PER_SESSION=60
ZHENLU_JOB_WORKER_ENABLED=true

# 如需估算费用，按实际模型、地域填写单价（元 / 百万 token），不填则仅统计用量。
# 问答/实时助手与病历模型不同时，不要共用不匹配的单价。
# ZHENLU_QWEN_INPUT_PRICE_PER_MILLION=
# ZHENLU_QWEN_OUTPUT_PRICE_PER_MILLION=

ZHENLU_ASR_PROVIDER=fun-asr
ZHENLU_FUN_ASR_API_KEY=
ZHENLU_FUN_ASR_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ZHENLU_FUN_ASR_MODEL=fun-asr-realtime-2026-02-28
ZHENLU_FUN_ASR_TIMEOUT_SECONDS=300
